# Local development values only. Docker Compose has matching defaults.
DJANGO_SECRET_KEY=django-insecure-local-biletflow-development-key-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=biletflow
POSTGRES_USER=biletflow
POSTGRES_PASSWORD=biletflow-local-only
BACKEND_PORT=8000
